# CloudBase 静态托管域名和 HTTP 访问服务域名通常不同，建议使用完整接口地址。
NEXT_PUBLIC_RESERVATION_ENDPOINT=https://your-env-id.service.tcloudbase.com/api/reservations
NEXT_PUBLIC_WORLDCUP_DESK_ENDPOINT=https://your-env-id.service.tcloudbase.com/api/worldcup-desk

# 首次初始化示例密码。正式环境请务必换成自己的强密码。
DOMI_ADMIN_USER=your-basic-auth-user
DOMI_ADMIN_PASSWORD=your-basic-auth-password
WC26_DEFAULT_ADMIN_PASSWORD=your-initial-admin-password
WC26_DEFAULT_CLIENT_PASSWORD=your-initial-client-password

# 如已配置同域路由，也可以改为：
# NEXT_PUBLIC_RESERVATION_ENDPOINT=/api/reservations
# NEXT_PUBLIC_WORLDCUP_DESK_ENDPOINT=/api/worldcup-desk
